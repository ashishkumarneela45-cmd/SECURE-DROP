rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // No direct client access - the app only reads/writes Firestore
    // through the Cloud Function (using the Admin SDK, which bypasses
    // these rules entirely). This blocks anyone from reading the
    // database directly from a browser.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
